---
import Layout from "@components/layouts/BaseLayout.astro";
import { BooksRepo } from "@server/repositories/book.repo";
import { Card, DataTable, Input, Button, Select, List } from "webcoreui/astro";

const booksRepo = BooksRepo();

// GET ALL BOOKS
const rows = (await booksRepo.getAllBooks()) as {
  id: number;
  judul: string;
  author: string;
  penerbit: string;
  kategori: string;
}[];

// Prepare data untuk DataTable
const tableData = rows.map((b) => [
  b.id.toString(),
  b.judul,
  b.author,
  b.penerbit,
  b.kategori,
]);

const tableHeadings = ["ID", "Judul", "Author", "Penerbit", "Kategori"];
---

<Layout>
  <Card class="max-w-4xl mx-auto p-4 my-8">
    <h1 class="text-2xl font-bold mb-4">📚 Data Buku</h1>

    <!-- FORM CREATE -->
    <form
      method="POST"
      action="/api/books"
      enctype="application/x-www-form-urlencoded"
      class="flex flex-col gap-3 mb-6"
    >
      <Input
        label="Judul"
        name="title"
        placeholder="Masukkan judul..."
        required
      />
      <Input
        label="Author"
        name="author"
        placeholder="Masukkan nama author..."
        required
      />
      <Input
        label="Penerbit"
        name="publisher"
        placeholder="Masukkan penerbit..."
        required
      />

      <Select
        name="category"
        label="Kategori"
        placeholder="Pilih kategori"
        itemGroups={[
          {
            title: "Kategori",
            items: [
              { value: "Fiksi", name: "Fiksi" },
              { value: "Non-Fiksi", name: "Non-Fiksi" },
              { value: "Teknologi", name: "Teknologi" },
              { value: "Sains", name: "Sains" },
            ],
          },
        ]}
      />

      <Button type="submit">Tambah</Button>
    </form>

    <script is:inline>
      import { listen } from "webcoreui";

      listen("selectOnChange", (event) => {
        console.log(event);
      });
    </script>
  </Card>

  <!-- DATATABLE -->
  <DataTable
    headings={tableHeadings}
    data={tableData}
    itemsPerPage={5}
    filterPlaceholder="Cari buku..."
    showFilterIcon={true}
    noResultsLabel="Tidak ada buku ditemukan"
  />
</Layout>
