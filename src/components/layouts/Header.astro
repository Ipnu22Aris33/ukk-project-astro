<header
  class="d-flex align-items-center px-3 border-bottom bg-body"
  style="height:56px"
>
  <!-- DESKTOP: collapse -->
  <button
    class="btn btn-link p-0 d-none d-md-inline-flex"
    data-bs-toggle="collapse"
    data-bs-target="#sidebarDesktop"
  >
    <i class="bi bi-layout-sidebar-inset fs-4"></i>
  </button>

  <!-- MOBILE: offcanvas -->
  <button
    class="btn btn-link p-0 d-md-none"
    data-bs-toggle="offcanvas"
    data-bs-target="#sidebarMobile"
  >
    <i class="bi bi-list fs-4"></i>
  </button>

  <span class="ms-3 fw-semibold">Dashboard</span>
</header>

